# Copia este fichero como ".env" (NO lo subas a GitHub) y rellena los valores.
# Lo usan backfill.py y daily_job.py cuando se ejecutan en local.

# --- Neo4j AuraDB (fichero .txt que descargas al crear la instancia) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- JEV (TypeSafe AI) ---
JEV_API_KEY=
# Endpoint directo de TypeSafe. Si usas JEV a través de AIML API, pon
#   JEV_API_URL=https://api.aimlapi.com/v1/decisions
#   JEV_MODEL=typesafe/jev
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=
JEV_THRESHOLD=0.90

# --- OpenAI (GPT) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
# Esfuerzo de razonamiento. Déjalo vacío si usas un modelo sin razonamiento (p. ej. gpt-4o-mini).
LLM_REASONING_EFFORT=low

# --- Semantic Scholar (opcional, pero sin clave va muy lento) ---
SEMANTIC_SCHOLAR_API_KEY=

# --- Ajustes opcionales ---
LOOKBACK_DAYS=3
JEV_WORKERS=8
LLM_WORKERS=4
LOG_LEVEL=INFO
