# Para probar la app en local: copia este fichero como .streamlit/secrets.toml (NO lo subas).
# En Streamlit Cloud pega este mismo contenido en: App -> Settings -> Secrets.
NEO4J_URI = "neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USERNAME = "neo4j"
NEO4J_PASSWORD = "tu-contraseña"
NEO4J_DATABASE = "neo4j"
